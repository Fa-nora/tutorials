<templates xml:space="preserve">

    <t t-name="awesome_clicker.ClickerClientAction">

        <div class="p-4">

            <div>
                Clicks:
                <ClickValue value="clicker.clicks"/>
            </div>

            <button
                class="btn btn-primary my-2"
                t-on-click="() => clicker.increment(10)"
            >
                Increment
            </button>

            <!-- Bots -->
            <t t-if="clicker.level gte 1">

                <h2 class="mt-3">
                    Bots
                </h2>

                <div class="d-flex gap-3">

                    <!-- ClickBot -->
                    <div class="border rounded p-3 flex-grow-1">

                        <div class="mb-3">
                            <ClickValue value="clicker.clickBots"/>
                            x clickbot (10 clicks/10seconds) 🤖
                        </div>

                        <button
                            class="btn btn-primary"
                            t-on-click="clicker.buyClickBot"
                            t-att-disabled="clicker.clicks lt 500"
                        >
                            Buy clickbot (500 clicks)
                        </button>

                    </div>

                    <!-- BigBot -->
                    <t t-if="clicker.level gte 2">

                        <div class="border rounded p-3 flex-grow-1">

                            <div class="mb-3">
                                <ClickValue value="clicker.bigBots"/>
                                x bigbot (100 clicks/10seconds) 🤖
                            </div>

                            <button
                                class="btn btn-primary"
                                t-on-click="clicker.buyBigBot"
                                t-att-disabled="clicker.clicks lt 600"
                            >
                                Buy bigbot (600 clicks)
                            </button>

                        </div>

                    </t>

                </div>

            </t>

            <!-- Power -->
            <t t-if="clicker.level gte 3">

                <h2 class="mt-3">
                    Power
                </h2>

                <div class="border rounded p-3">

                    <div class="mb-3">
                        Power level:
                        <ClickValue value="clicker.power"/>
                    </div>

                    <button
                        class="btn btn-primary"
                        t-on-click="clicker.buyPower"
                        t-att-disabled="clicker.clicks lt 900"
                    >
                        Buy power (900 clicks)
                    </button>

                </div>

            </t>

        </div>

    </t>

</templates>