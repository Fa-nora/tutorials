<templates xml:space="preserve">

    <t t-name="awesome_clicker.ClickerClientAction">

        <div class="p-4">

            <!-- Clicks -->
	        <div class="d-flex align-items-center gap-3 mb-3">
                <span>
                    Clicks:
                    <ClickValue value="clicker.clicks"/>
                </span>

		        <button
				        class="btn btn-primary"
				        t-on-click="() => clicker.increment(10)"
		        >
                    Increment
                </button>
            </div>


	        <!-- Bots -->
	        <t t-if="clicker.level >= 1">

                <h2>Bots</h2>

		        <!-- ClickBot -->
		        <div class="border rounded p-3 mb-3">

                    <div>
                        🤖
                        <ClickValue value="clicker.clickBots"/>
	                    x ClickBot
	                    (10 clicks/10 seconds)
                    </div>

			        <button
					        class="btn btn-primary"
					        t-on-click="() => clicker.buyClickBot()"
					        t-att-disabled="clicker.clicks lt 200"
			        >Buy ClickBot (200 clicks)</button>

                </div>

            </t>


	        <!-- BigBots -->
	        <t t-if="clicker.level >= 2">

                <div class="border rounded p-3 mb-3">

                    <div>
                        🤖
                        <ClickValue value="clicker.bigBots"/>
	                    x BigBot
	                    (100 clicks/10 seconds)
                    </div>

	                <button
			                class="btn btn-primary"
			                t-on-click="() => clicker.buyBigBot()"
			                t-att-disabled="clicker.clicks lt 300"
	                >
    Buy BigBot (300 clicks)
</button>

                </div>

            </t>


	        <!-- Power -->
	        <t t-if="clicker.level >= 3">

                <h2>Power</h2>

		        <div class="border rounded p-3 mb-3">

                    <div>
                        Power level:
                        <ClickValue value="clicker.power"/>
                    </div>

			        <button
					        class="btn btn-primary"
					        t-on-click="() => clicker.buyPower()"
					        t-att-disabled="clicker.clicks lt 400"
			        >
    Buy power (400 clicks)
</button>

                </div>


		        <!-- Trees -->

		        <h2>Trees</h2>

		        <div class="border rounded p-3 mb-3">

                    <div>
                        🌳
                        <ClickValue value="clicker.pearTrees"/>
	                    x Pear Tree
                    </div>

			        <button
					        class="btn btn-primary"
					        t-on-click="() => clicker.buyPearTree()"
					        t-att-disabled="clicker.clicks lt 500"
			        >
    Buy pear tree (500 clicks) 🍐
</button>

                </div>


		        <div class="border rounded p-3 mb-3">

                    <div>
                        🌳
                        <ClickValue value="clicker.cherryTrees"/>
	                    x Cherry Tree
                    </div>

			        <button
    class="btn btn-primary"
    t-on-click="() => clicker.buyCherryTree()"
    t-att-disabled="clicker.clicks lt 500"
>
    Buy cherry tree (500 clicks) 🍒
</button>

                </div>


		        <h2>Fruits</h2>

		        <div class="border rounded p-3">

                    <div>
                        Pears:
                        <ClickValue value="clicker.pearFruits"/>
                    </div>

			        <div>
                        Cherries:
                        <ClickValue value="clicker.cherryFruits"/>
                    </div>

			        <div>
                        Total fruits:
                        <ClickValue value="clicker.totalFruits"/>
                    </div>

                </div>

            </t>

        </div>

    </t>

</templates>