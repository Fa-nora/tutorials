<templates xml:space="preserve">

    <t t-name="awesome_clicker.ClickerClientAction">

        <div class="p-4">

            <!-- تب‌های ناوبری -->
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a class="nav-link" t-att-class="{ active: state.activeTab === 'clicks' }" href="#" t-on-click.prevent="() => this.switchTab('clicks')">
                        Clicks
                    </a>
                </li>
                <li class="nav-item" t-if="clicker.level gte 3">
                    <a class="nav-link" t-att-class="{ active: state.activeTab === 'trees' }" href="#" t-on-click.prevent="() => this.switchTab('trees')">
                        Trees and Fruits
                    </a>
                </li>
            </ul>

            <!-- محتوای تب اول: Clicks -->
            <div t-if="state.activeTab === 'clicks'">

                <div class="d-flex align-items-center gap-3 my-2">
                    <span>
                        Clicks:
                        <ClickValue value="clicker.clicks"/>
                    </span>

                    <button
                        class="btn btn-primary"
                        t-on-click="() => clicker.increment(10)"
                    >
                        Increment
                    </button>
                </div>

                <!-- Bots -->
                <t t-if="clicker.level gte 1">
                    <h2 class="mt-3">Bots</h2>
                    <div class="d-flex gap-3">

                        <!-- ClickBot -->
                        <div class="border rounded p-3 flex-grow-1">
                            <div class="mb-3">
                                <ClickValue value="clicker.clickBots"/>
                                x ClickBot (10 clicks/10seconds) 🤖
                            </div>
                            <button
                                class="btn btn-primary"
                                t-on-click="() => clicker.buyClickBot()"
                                t-att-disabled="clicker.clicks lt 200"
                            >
                                Buy ClickBot (200 clicks)
                            </button>
                        </div>

                        <!-- BigBot -->
                        <t t-if="clicker.level gte 2">
                            <div class="border rounded p-3 flex-grow-1">
                                <div class="mb-3">
                                    <ClickValue value="clicker.bigBots"/>
                                    x BigBot (100 clicks/10seconds) 🤖
                                </div>
                                <button
                                    class="btn btn-primary"
                                    t-on-click="() => clicker.buyBigBot()"
                                    t-att-disabled="clicker.clicks lt 300"
                                >
                                    Buy BigBot (300 clicks)
                                </button>
                            </div>
                        </t>

                    </div>
                </t>

                <!-- Power -->
                <t t-if="clicker.level gte 3">
                    <h2 class="mt-3">Power</h2>
                    <div class="border rounded p-3">
                        <div class="mb-3">
                            Power level:
                            <ClickValue value="clicker.power"/>
                        </div>
                       <button
                            class="btn btn-primary"
                            t-on-click="() => clicker.buyPower()"
                            t-att-disabled="clicker.clicks lt 400"
                        >
                            Buy power (400 clicks)
                        </button>
                    </div>
                </t>

            </div>

            <!-- محتوای تب دوم: Trees and Fruits -->
            <div t-if="state.activeTab === 'trees'">

                <h2 class="mt-3">Trees 🌳</h2>

                <div class="border rounded p-3 mb-3">
                    <div class="mb-3">
                        Trees:
                        <ClickValue value="clicker.totalTrees"/>
                    </div>
                    <div class="mb-3">
                        Fruits:
                        <ClickValue value="clicker.totalFruits"/>
                    </div>

                    <div class="d-flex gap-2">
                        <button
                            class="btn btn-primary"
                            t-on-click="() => clicker.buyPearTree()"
                            t-att-disabled="clicker.clicks lt 500"
                        >
                            Buy pear tree (500 clicks) 🍐
                        </button>

                        <button
                            class="btn btn-primary"
                            t-on-click="() => clicker.buyCherryTree()"
                            t-att-disabled="clicker.clicks lt 500"
                        >
                            Buy cherry tree (500 clicks) 🍒
                        </button>

                        <button
                            class="btn btn-primary"
                            t-on-click="() => clicker.buyPeachTree()"
                            t-att-disabled="clicker.clicks lt 500"
                        >
                            Buy peach tree (500 clicks) 🍑
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </t>

</templates>