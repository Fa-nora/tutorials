<templates xml:space="preserve">

    <t t-name="awesome_clicker.ClickerClientAction">

        <div class="p-4">

            <div class="d-flex align-items-center gap-3">

                <span>
                    Clicks:
                    <ClickValue value="clicker.clicks"/>
                </span>

                <button
                    class="btn btn-primary"
                    t-on-click="() => clicker.increment(10)"
                >
                    Increment
                </button>

            </div>

            <t t-if="clicker.level >= 1">

                <h2 class="mt-3">
                    Bots
                </h2>

                <div class="border rounded p-3">

                    <div class="mb-3">
                        <ClickValue value="clicker.clickBots"/>
                        x ClickBots (10 clicks/10 seconds)
                    </div>

                    <button
                        class="btn btn-primary"
                        t-on-click="clicker.buyClickBot"
                        t-att-disabled="clicker.clicks &lt; 1000"
                    >
                        Buy ClickBot (1000 clicks)
                    </button>

                </div>

            </t>

        </div>

    </t>

</templates>