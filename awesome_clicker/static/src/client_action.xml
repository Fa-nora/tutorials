<templates xml:space="preserve">

    <t t-name="awesome_clicker.ClickerClientAction">

        <div class="p-4">

            <div>
                Clicks:
                <ClickValue value="clicker.clicks"/>
            </div>

            <button
                class="btn btn-primary"
                t-on-click="() => clicker.increment(10)"
            >
                Increment
            </button>


            <!-- ClickBots -->

            <t t-if="clicker.level >= 1">

                <h2 class="mt-3">
                    Bots
                </h2>

                <div class="border rounded p-3">

                    <div class="mb-3">
                        <ClickValue value="clicker.clickBots"/>
                          x ClickBots (10 clicks/10 seconds)
                    </div>

                    <button
                        class="btn btn-primary"
                        t-on-click="clicker.buyClickBot"
                        t-att-disabled="clicker.clicks &lt; 1000"
                    >
                        Buy ClickBot (1000 clicks)
                    </button>

                </div>

            </t>


            <!-- BigBots -->

            <t t-if="clicker.level >= 2">

                <h2 class="mt-3">
                    BigBots
                </h2>

                <div class="border rounded p-3">

                    <div class="mb-3">
                        <ClickValue value="clicker.bigBots"/>
                        x BigBots (100 clicks/10 seconds)
                    </div>

                    <button
                        class="btn btn-primary"
                        t-on-click="clicker.buyBigBot"
                        t-att-disabled="clicker.clicks &lt; 5000"
                    >
                        Buy BigBot (5000 clicks)
                    </button>

                </div>

            </t>

        </div>

    </t>

</templates>