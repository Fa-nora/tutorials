<templates xml:space="preserve">

    <t t-name="awesome_clicker.ClickerSystrayItem">

        <Dropdown>

            <!-- Systray button -->
            <button class="btn btn-link d-flex align-items-center gap-3">

                <!-- Clicks -->
                <span class="d-flex align-items-center gap-1">
                    <i class="fa fa-mouse-pointer"/>
                    <ClickValue value="clicker.clicks"/>
                </span>

                <!-- Trees -->
                <span class="d-flex align-items-center gap-1">
                    <i class="fa fa-tree"/>
                    <ClickValue value="clicker.totalTrees"/>
                </span>

                <!-- Fruits -->
                <span class="d-flex align-items-center gap-1">
                    <i class="fa fa-lemon-o"/>
                    <ClickValue value="clicker.totalFruits"/>
                </span>

            </button>


            <!-- Dropdown content -->
            <t t-set-slot="content">

                <!-- Trees -->
                <div class="px-3 py-2">

                    <div class="fw-bold mb-2">
                        🌳 Trees
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Pear trees</span>
                        <ClickValue value="clicker.pearTrees"/>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Cherry trees</span>
                        <ClickValue value="clicker.cherryTrees"/>
                    </div>

                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total trees</span>
                        <ClickValue value="clicker.totalTrees"/>
                    </div>

                </div>


                <div class="dropdown-divider"/>


                <!-- Fruits -->
                <div class="px-3 py-2">

                    <div class="fw-bold mb-2">
                        🍐 Fruits
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Pears</span>
                        <ClickValue value="clicker.pearFruits"/>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Cherries</span>
                        <ClickValue value="clicker.cherryFruits"/>
                    </div>

                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total fruits</span>
                        <ClickValue value="clicker.totalFruits"/>
                    </div>

                </div>


                <div class="dropdown-divider"/>


                <!-- Open game -->
                <DropdownItem onSelected.bind="openGame">

                    <i class="fa fa-gamepad me-2"/>

                    Open clicker game

                </DropdownItem>


                <!-- Buy ClickBot -->
                <DropdownItem
                    onSelected.bind="buyClickBot"
                    t-if="clicker.level >= 1"
                    disabled="clicker.clicks lt 200"
                >

                    <i class="fa fa-android me-2"/>

                    Buy ClickBot

                    <span class="ms-auto">
                        200 clicks
                    </span>

                </DropdownItem>

            </t>

        </Dropdown>

    </t>

</templates>