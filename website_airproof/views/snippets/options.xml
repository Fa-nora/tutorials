<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- تعریف فیلتر داینامیک دیتابیس برای اتصال مدل محصولات به قالب Airproof -->
        <record id="dynamic_filter_airproof_products" model="website.snippet.filter">
            <field name="name">Airproof Latest Products</field>
            <field name="model_name">product.product</field>
            <field name="website_id" eval="1"/>
            <field name="field_names">name,description_sale,image_512,price</field>
            <field name="limit" eval="16"/>
        </record>

        <!-- بخش منوی ساختار ادیتور (Snippets) منطبق بر تگ‌های سورس بومی اودو 19 -->
        <template id="snippets" inherit_id="website.snippets" name="Airproof - Custom Snippets">
            <xpath expr="//snippets[@id='snippet_groups']" position="inside">
                <t snippet-group="airproof"
                   t-snippet="website.s_snippet_group"
                   string="Airproof"
                   t-thumbnail="/website_airproof/static/src/img/wbuilder/s-airproof-snippet.svg"/>
            </xpath>

            <xpath expr="//snippets[@id='snippet_structure']" position="inside">
                <t t-snippet="website_airproof.s_airproof_carousel"
                   string="Custom carousel"
                   group="airproof">
                    <keywords>Carousel drone airproof</keywords>
                </t>
            </xpath>
        </template>

        <!-- قالب محصولات داینامیک ۱۰۰٪ مرتب و هم‌تراز شده برای اودو ۱۹ -->
        <template id="dynamic_filter_template_product_product_airproof" name="Airproof product template">
            <t t-foreach="records" t-as="data">
                <t t-set="record" t-value="data['_record']"/>
                <div class="o_carousel_product_card card h-100 w-100 border-0 shadow-sm"
                     t-att-data-add2cart-rerender="data.get('_add2cart_rerender')"
                     style="border-radius: 15px; overflow: hidden;">

                    <div t-if="is_sample" class="h5 o_ribbon_right bg-primary text-uppercase">Sample</div>
                    <input type="hidden" name="product-id" t-att-data-product-id="record.id"/>

                    <!-- بخش تصویر: فیکس کردن متد واکشی عکس در اودو ۱۹ جهت جلوگیری از شکستگی تصویر -->
                    <a class="o_carousel_product_img_link d-block bg-white text-center p-3" t-att-href="record.website_url" style="height: 200px;">
                        <img class="o_carousel_product_card_img_top card-img-top h-100"
                             t-att-src="data.get('image_url') or request.website.image_url(record, 'image_512')"
                             t-att-alt="record.display_name"
                             style="object-fit: contain; max-height: 100%;"
                             loading="lazy"/>
                    </a>

                    <!-- بدنه اطلاعات کارت محصول: هم‌تراز شده به صورت عمودی -->
                    <div class="o_carousel_product_card_body card-body d-flex flex-column justify-content-between p-3" style="min-height: 140px; background-color: #ffffff;">
                        <div>
                            <div class="h6 card-title mb-1 fw-bold text-dark" t-field="record.display_name"/>
                            <div class="product_price mt-1">
                                <t t-call="website_sale.price_dynamic_filter_template_product_product"/>
                            </div>
                        </div>
                        <div class="pt-2">
                            <span class="small text-dark fw-bold text-uppercase" style="letter-spacing: 0.5px;">
                                Discover more
                                <img src="/website_airproof/static/src/img/content/icons/arrow-small.svg" alt="" class="ms-1" style="width: 10px;"/>
                            </span>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
