<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--  تغییر آیکون سبد خرید در هدر -->
    <template id="header_cart_link" inherit_id="website_sale.header_cart_link" name="Airproof - Cart icon">
        <xpath expr="//i" position="replace">
            <img src="/website_airproof/static/src/img/content/icons/shopping.svg" alt="shopping icon"/>
        </xpath>
    </template>

    <!--  افزودن بنر بالای صفحه فروشگاه -->
    <template id="products" inherit_id="website_sale.products" name="Airproof - Products">
        <xpath expr="//div[@id='oe_structure_website_sale_products_1']" position="inside">
            <!-- اصلاح آدرس تصویر به مسیر فیزیکی دقیق پوسته شما در   -->
            <section class="s_title bg-black-50 o_colored_level s_parallax_no_overflow_hidden oe_img_bg o_bg_img_center pt88 pb88" data-vcss="001" data-snippet="s_title"
                     style="background-image: url('/website_airproof/static/src/img/content/topview3.webp'); background-size: cover; background-position: center;">
                <div class="o_we_bg_filter bg-black-50" style="opacity:0.5;"/>
                <div class="container text-center"><h2 class="text-white">Discover our amazing products</h2></div>
            </section>
        </xpath>
        <xpath expr="//div[contains(@class,'products_header')]" position="attributes">
            <attribute name="class" add="justify-content-end" remove="justify-content-between" separator=" "/>
        </xpath>
    </template>

    <!--  حذف کادر جستجوی پیش‌فرض -->
    <template id="search" inherit_id="website_sale.search" name="Airproof - Search">
        <xpath expr="//t[@t-call='website.website_search_box_input']" position="replace"/>
    </template>

    <!--  افزودن Discover more به کارت‌ها -->
    <template id="products_item" inherit_id="website_sale.products_item" name="Airproof - Products item">
        <xpath expr="//div[hasclass('o_wsale_product_information')]" position="inside">
            <span class="small text-dark pt-3 pb-1 d-block">Discover more
                <img src="/website_airproof/static/src/img/content/icons/arrow-small.svg" alt="" class="ms-2"/>
            </span>
        </xpath>
    </template>

    <!--  ایجاد موقعیت  -->
    <template id="product" inherit_id="website_sale.product" name="Airproof - Product">
	    <xpath expr="//section[@id='product_detail']" position="after">
		    <div id="oe_structure_layout_airproof_products" class="oe_structure oe_empty" data-editor-message="DROP ZONE VISIBLE ACROSS ALL PRODUCTS"/>
	    </xpath>
    </template>

    <!--  جایگزینی آیکون دکمه سبد خرید -->
	<template id="cta_wrapper" inherit_id="website_sale.cta_wrapper" name="Airproof - CTA">
        <xpath expr="//a[@id='add_to_cart']/i" position="replace">
            <img src="/website_airproof/static/src/img/content/icons/shopping.svg" alt="Shopping icon" class="img img-fluid me-1"/> Add to cart
        </xpath>
    </template>

    <!--. جدول مشخصات فنی محصول  -->
    <template id="product_accordion" inherit_id="website_sale.product_accordion" name="Airproof - Specs">
        <xpath expr="//div[@id='product_accordion']" position="inside">
            <div class="accordion-item">
                <div t-if="product.valid_product_template_attribute_line_ids._prepare_single_value_for_display()" class="accordion-header my-0 h6">
                    <button class="accordion-button collapsed fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#specifications">Specifications</button>
                </div>
                <div id="specifications" class="accordion-collapse collapse" data-bs-parent="#product_accordion">
                    <div class="accordion-body pt-0">
                        <div id="product_attributes_simple">
                            <t t-set="single_value_attributes" t-value="product.valid_product_template_attribute_line_ids._prepare_single_value_for_display()"/>
                            <table t-attf-class="table table-sm text-muted {{'' if single_value_attributes else 'd-none'}}">
                                <t t-foreach="single_value_attributes" t-as="attribute">
                                    <tr>
                                        <td class="border-0">
                                            <span t-field="attribute.name"/>:
                                            <t t-foreach="single_value_attributes[attribute]" t-as="ptal">
                                                <span t-field="ptal.product_template_value_ids._only_active().name"/>
                                                <t t-if="not ptal_last">, </t>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!--  وسط‌چین کردن  گالری تصاویر -->
    <template id="carousel_product_indicators" inherit_id="website_sale.carousel_product_indicators" name="Airproof - Carousel">
        <xpath expr="//ol" position="attributes">
            <attribute name="t-att-class" add="' justify-content-center p-3'" separator=" + "/>
        </xpath>
        <xpath expr="//li" position="attributes">
            <attribute name="t-attf-class" add="border-0 rounded" separator=" "/>
        </xpath>
    </template>

    <!-- محصولات پیشنهادی دیگر -->
    <template id="alternative_products" inherit_id="website_sale.alternative_products" name="Airproof - Alternative">
        <xpath expr="//div[@id='oe_structure_website_sale_recommended_products']" position="before">
            <section class="s_title pt64 pb64 o_colored_level" data-vcss="001" data-snippet="s_title" style="background-color: #E6E7E8;" t-if="product.alternative_product_ids">
                <div class="container s_allow_columns"><h2 class="text-center fw-bold">You might also like</h2></div>
            </section>
        </xpath>
    </template>




</odoo>
