<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ۱. اصلاح آیکون سبد خرید در منوی هدر سایت با تصویر SVG -->
    <template id="header_cart_link" inherit_id="website_sale.header_cart_link" name="Airproof - Cart icon">
        <xpath expr="//i" position="replace">
            <img src="/website_airproof/static/src/img/content/icons/shopping.svg" alt="shopping icon" style="width: 20px; height: 20px;"/>
        </xpath>
    </template>

    <!--  شخصی‌سازی صفحه فروشگاه: افزودن بنر بالای محصولات -->
    <template id="products" inherit_id="website_sale.products" name="Airproof - Products">
        <xpath expr="//*[@id='oe_structure_website_sale_products_1']" position="inside">
            <section class="s_title bg-black-50 o_colored_level s_parallax_no_overflow_hidden oe_img_bg o_bg_img_center pt88 pb88"
                     data-snippet="s_title"
                     style="background-image: url('/website_airproof/static/src/img/content/topview3.webp'); background-size: cover; background-position: center;">
                <div class="o_we_bg_filter bg-black-50" style="opacity: 0.5;"/>
                <div class="container text-center">
                    <h2 class="text-white display-4 fw-bold">Discover our amazing products</h2>
                </div>
            </section>
        </xpath>
        <xpath expr="//div[contains(@class, 'products_header')]" position="attributes">
            <attribute name="class" add="justify-content-end" remove="justify-content-between" separator=" "/>
        </xpath>
    </template>

    <!-- ۳. حذف کامل باکس جستجوی پیش‌فرض صفحه فروشگاه -->
    <template id="search" inherit_id="website_sale.search" name="Airproof - Search">
        <xpath expr="//t[@t-call='website.website_search_box_input']" position="replace"/>
    </template>

    <!-- ۴. تزریق خودکار بخش تبلیغاتی شش دلیل به زیر محصول به همراه آرس دقیق استاتیک امواج فیروزه‌ای -->
    <template id="product" inherit_id="website_sale.product" name="Airproof - Product">
        <xpath expr="//section[@id='product_detail']" position="after">

            <div id="oe_structure_layout_airproof_products"
                 class="oe_structure oe_empty"
                 data-editor-message="DROP ZONE VISIBLE ACROSS ALL PRODUCTS"/>

            <section class="s_text_image o_colored_level pt80 pb80"
                     data-snippet="s_text_image"
                     data-name="Image - Text"
                     style="background-color: #E8F5C8; background-image: url('/website_airproof/static/shapes/airproof/waves.svg'); background-size: cover; background-position: center;">
                <div class="container">
                    <div class="row align-items-center">
                        <!-- ستون سمت چپ: متون تیتر و پاراگراف‌ها کاملاً منطبق بر عکس تمرین -->
                        <div class="col-lg-6 pt16 pb16 o_colored_level text-start">
                            <h2 class="display-5 fw-bold text-dark mb-3">Six reasons to buy the Airproof Mini.</h2>
                            <p class="lead text-muted mb-4" style="line-height: 1.6;">
                                Airproof Mini is
                                <span class="fw-bold px-1 rounded" style="background-color: #CEF8A1; color: #000000;">more than just a mini drone.</span>
                                The lightweight body supports powerful features, making it a great choice for first-time flyers.
                            </p>
                            <a href="/shop" class="btn btn-dark btn-lg rounded-pill px-4">Learn more →</a>
                        </div>
                        <!-- ستون سمت راست: لود تصویر پهپاد با بک‌اِند آبی با آدرس استاتیک -->
                        <div class="col-lg-6 pt16 pb16 o_colored_level text-center">
                            <img src="/website_airproof/static/src/img/content/drone-bluebg.webp"
                                 class="img img-fluid mx-auto rounded-3"
                                 alt="Airproof Mini"
                                 style="max-height: 350px; object-fit: contain;"/>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!--  تغییر شکل و آیکون دکمه سبد خرید از طریق کلاس‌های بومی فرم  برای جلوگیری از خطای xpath -->
    <template id="product_buy_now_custom" inherit_id="website_sale.product_buy_now" name="Airproof - Add to Cart Fix">
        <xpath expr="//a[contains(@class, 'btn-primary')]" position="inside">
            <style>
                .o_product_page_buy_now i, #add_to_cart i { display: none !important; }
            </style>
            <img src="/website_airproof/static/src/img/content/icons/shopping.svg" alt="Shopping icon" class="img img-fluid me-2" style="width: 18px; height: 18px; display: inline-block; vertical-align: middle;"/>
        </xpath>
    </template>

    <!--  قرار دادن جدول مشخصات فنی (Specifications) محصول در آکاردئون تاشوی بومی  -->
    <template id="product_accordion" inherit_id="website_sale.product_accordion" name="Airproof - Specs">
        <xpath expr="//div[@id='product_accordion']" position="inside">
            <div class="accordion-item">
                <div t-if="product.valid_product_template_attribute_line_ids"
                     class="accordion-header my-0 h6" id="heading_specifications">
                    <button class="accordion-button collapsed fw-medium" type="button"
                            data-bs-toggle="collapse" data-bs-target="#specifications"
                            aria-expanded="false" aria-controls="specifications">
                        Specifications
                    </button>
                </div>
                <div id="specifications" class="accordion-collapse collapse" aria-labelledby="heading_specifications"
                     data-bs-parent="#product_accordion">
                    <div class="accordion-body pt-3">
                        <div id="product_attributes_simple">
                            <table class="table table-sm text-muted">
                                <t t-foreach="product.valid_product_template_attribute_line_ids" t-as="attribute_line">
                                    <tr>
                                        <td class="border-0 fw-bold" style="width: 30%;"><span t-field="attribute_line.attribute_id.name"/>:</td>
                                        <td class="border-0">
                                            <t t-foreach="attribute_line.product_template_value_ids" t-as="value">
                                                <span t-field="value.name"/><t t-if="not value_last">, </t>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- اصلاح و تراز عمودی نشانگرهای کاروسل تصاویر گالری در  -->
    <template id="carousel_product_indicators" inherit_id="website_sale.carousel_product_indicators" name="Airproof - Carousel">
        <xpath expr="//ol" position="attributes">
            <attribute name="t-att-class" add="' justify-content-center p-3'" separator=" + "/>
        </xpath>
        <xpath expr="//li" position="attributes">
            <attribute name="t-attf-class" add="border-0 rounded" separator=" "/>
        </xpath>
    </template>


    <!--  بخش محصولات پیشنهادی خودکار (Automated Dynamic Recommendations)-->

    <template id="airproof_automatic_recommended_products" inherit_id="website_sale.product" name="Airproof - Auto Recommendations">
        <xpath expr="//section[@id='product_detail']" position="after">

            <!-- سکشن خاکستری و شیک محصولات پیشنهادی منطبق بر طرح اصلی Airproof -->
            <section class="s_title pt64 pb64 o_colored_level" style="background-color: #E6E7E8;" id="airproof_automatic_recommendations">
                <div class="container">
                    <h2 class="text-center fw-bold text-dark display-6 mb-5">You might also like</h2>

                    <div class="row g-4">
                        <!-- جستجوی هوشمند پایتونی: واکشی خودکار ۴ محصول مرتبط هم‌دسته که محصول فعلی نیستند -->
                        <t t-set="recommended_products" t-value="request.env['product.template'].sudo().search([
                            ('id', '!=', product.id),
                            ('sale_ok', '=', True),
                            ('website_published', '=', True),
                            ('public_categ_ids', 'in', product.public_categ_ids.ids)
                        ], limit=4)"/>

                        <!-- حلقه تکرار برای رندر کردن تک‌تک کارت‌های پهپادهای پیشنهادی -->
                        <t t-foreach="recommended_products" t-as="recommended">
                            <div class="col-6 col-md-3">
                                <a t-att-href="recommended.website_url" class="text-decoration-none text-dark d-block h-100">

                                    <!-- کادر سفید کارت محصول مطابق کارت‌های صفحه شاپ شما -->
                                    <div class="o_carousel_product_card card h-100 border-0 shadow-sm" style="border-radius: 16px; overflow: hidden; background: #ffffff;">

                                        <!-- بارگذاری ایمن آدرس تصویر محصول از دیتابیس اودو ۱۹ -->
                                        <div class="d-block bg-white text-center p-3" style="height: 180px;">
                                            <img t-att-src="request.website.image_url(recommended, 'image_512')"
                                                 t-att-alt="recommended.name"
                                                 class="card-img-top h-100"
                                                 style="object-fit: contain; max-height: 100%;"
                                                 loading="lazy"/>
                                        </div>

                                        <!-- مشخصات متنی کالا هم‌تراز شده درون کادر سفید -->
                                        <div class="card-body text-center p-3 d-flex flex-column justify-content-between" style="background-color: #ffffff;">
                                            <div>
                                                <div class="h6 card-title mb-1 fw-bold text-dark" t-out="recommended.name"/>
                                                <div class="product_price mt-1">
                                                    <span class="fw-bold text-success" t-field="recommended.list_price"
                                                          t-options="{'widget': 'monetary', 'display_currency': recommended.currency_id}"/>
                                                </div>
                                            </div>
                                            <div class="pt-2 border-top mt-2">
                                                <span class="small text-dark fw-bold text-uppercase" style="letter-spacing: 0.5px;">
                                                    Discover more
                                                    <img src="/website_airproof/static/src/img/content/icons/arrow-small.svg" alt="" class="ms-1" style="width: 10px; display: inline-block;"/>
                                                </span>
                                            </div>
                                        </div>

                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

        </xpath>
    </template>


</odoo>

