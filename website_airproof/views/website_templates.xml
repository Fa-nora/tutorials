<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<record id="website.header_call_to_action" model="ir.ui.view">
		<field name="active" eval="False"/>
	</record>
	<record id="website.template_header_default" model="ir.ui.view">
		<field name="active" eval="False"/>
	</record>
	<record id="website.footer_custom" model="ir.ui.view">
		<field name="active" eval="False"/>
	</record>
	<record id="website.footer_no_copyright" model="ir.ui.view">
		<field name="active" eval="False"/>
	</record>


	<record id="header" model="ir.ui.view">
		<field name="name">Airproof header</field>
		<field name="type">qweb</field>
		<field name="key">website_airproof.header</field>
		<field name="inherit_id" ref="website.layout"/>
		<field name="mode">extension</field>
		<field name="arch" type="xml">
			<xpath expr="//header" position="replace">
				<header id="top" data-anchor="true" data-name="Header" class="o_header_standard">

					<t t-call="website.navbar">
						<t t-set="_navbar_classes" t-valuef="d-none d-lg-block p-0"/>
						<div id="o_main_nav" class="o_main_nav flex-wrap w-100">

							<div class="container d-grid align-items-center w-100 py-2 o_grid_header_3_cols">

								<!-- منو چپ -->
								<ul class="navbar-nav flex-row flex-wrap align-items-center gap-3 mb-0">
									<li class="nav-item dropdown">
										<a href="/shop" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
											Waterproof drones
											<img src="/website_airproof/static/src/img/content/icons/angle-down-solid.svg" class="ms-1" style="width:12px; height: 12px;"/>
										</a>
										<ul class="dropdown-menu">
											<li><a class="dropdown-item" href="/shop">Airproof Mini</a></li>
											<li><a class="dropdown-item" href="/shop">Airproof Pro</a></li>
											<li><a class="dropdown-item" href="/shop">Airproof Robin</a></li>
											<li><a class="dropdown-item" href="/shop">Airproof Falcon</a></li>
											<li><a class="dropdown-item" href="/shop">Airproof Eagle</a></li>
										</ul>
									</li>

									<li class="nav-item">
										<a href="/about-us" class="nav-link">About us</a>
									</li>

									<li class="nav-item dropdown">
										<a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
											Blog
											<img src="/website_airproof/static/src/img/content/icons/angle-down-solid.svg" class="ms-1" style="width:12px; height: 12px;"/>
										</a>
										<ul class="dropdown-menu">
											<li><a class="dropdown-item" href="/blog">Our latest news</a></li>
											<li><a class="dropdown-item" href="/blog">Tutorials</a></li>
										</ul>
									</li>

									<li class="nav-item">
										<a href="/contactus" class="nav-link">Contact us</a>
									</li>
								</ul>

								<!--  وسط -->
								<div class="d-flex justify-content-center">
									<t t-call="website.placeholder_header_brand">
										<t t-set="_link_class" t-valuef="navbar-brand mx-auto"/>
									</t>
								</div>

								<!-- منو راست: آیکون سبد خرید + آیکون لیست علاقه‌مندی‌ها + دکمه ورود -->
								<ul class="navbar-nav flex-row align-items-center gap-2 justify-content-end mb-0">
									<t t-call="website_sale.header_cart_link">
										<t t-set="_icon" t-value="True"/>
										<t t-set="_item_class" t-valuef="nav-item"/>
										<t t-set="_link_class" t-valuef="nav-link"/>
									</t>

									<t t-call="website_sale_wishlist.header_wishlist_link">
										<t t-set="_icon" t-value="True"/>
										<t t-set="_item_class" t-valuef="nav-item"/>
										<t t-set="_link_class" t-valuef="nav-link"/>
									</t>
									<t t-call="portal.placeholder_user_sign_in">
										<t t-set="_link_class" t-valuef="btn btn-primary btn-sm rounded-sm px-3"/>
									</t>
									<t t-call="portal.user_dropdown">
										<t t-set="_user_name" t-value="true"/>
										<t t-set="_icon" t-value="true"/>
										<t t-set="_item_class" t-valuef="dropdown"/>
										<t t-set="_link_class" t-valuef="btn btn-primary btn-sm rounded-sm"/>
									</t>
								</ul>

							</div>
						</div>
					</t>
					<t t-call="website.template_header_mobile"/>
				</header>
			</xpath>
		</field>
	</record>


	<record id="footer" model="ir.ui.view">
		<field name="name">Airproof Footer</field>
		<field name="type">qweb</field>
		<field name="key">website_airproof.footer</field>
		<field name="inherit_id" ref="website.layout"/>
		<field name="mode">extension</field>
		<field name="arch" type="xml">
			<xpath expr="//footer" position="replace">
				<footer id="footer" class="oe_structure" t-ignore="true" t-if="not no_footer">


					<section class="s_newsletter_block s_newsletter_list o_colored_level o_cc o_cc4 pt48 pb48"
					         data-list-id="1"
					         data-snippet="s_newsletter_block"
					         data-name="Newsletter Block">
						<div class="container">
							<div class="row">
								<div class="pt8 pb8 o_colored_level col-lg-6">
									<h2>Sign up for our newsletter</h2>
									<p>Don't miss the newsletter with news and special offers!</p>
								</div>
								<div class="pt40 pb8 o_colored_level col-lg-6">
									<div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe"
									     data-vxml="001"
									     data-list-id="0"
									     data-name="Newsletter Form"
									     data-snippet="s_newsletter_subscribe_form">
										<div class="js_subscribed_wrap d-none">
											<p class="text-end text-success">
												<i class="fa fa-check-circle-o" role="img"/> Thanks for registering!
											</p>
										</div>
										<div class="js_subscribe_wrap">
											<div class="input-group">
												<input type="email" name="email" class="js_subscribe_value form-control border-0 me-3" placeholder="Your email..."/>
												<a role="button" href="#" class="btn btn-primary o_cc o_cc3 js_subscribe_btn o_submit">Subscribe</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</section>

					<!-- محتوای متنی بدنه فوتر -->
					<section class="s_text_block pt80 pb24 bg-black text-white" data-snippet="s_text_block" data-name="Text">
						<div class="container">
							<div class="row">
								<div class="col col-lg-6 pb40 pe-md-5">
									<p class="small">
										Creativity is at the heart of every dream. Every idea, every groundbreaking leap that changes our world starts with the vision of talented creators. At Airproof, we give these creators the tools they need to bring
										their ideas to life.
									</p>
								</div>
								<div class="col-6 col-md-4 col-lg-2 pb24 text-white">
									<p class="mb-4 text-muted small">Our drones</p>
									<ul class="list-unstyled small">
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Airproof Mini</a></li>
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Airproof Pro</a></li>
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Airproof Robin</a></li>
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Airproof Falcon</a></li>
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Airproof Eagle</a></li>
									</ul>
								</div>
								<div class="col-6 col-md-4 col-lg-2 pb24 text-white">
									<p class="mb-4 text-muted small">Our accessories</p>
									<ul class="list-unstyled small">
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Drones cases</a></li>
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Float kit</a></li>
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Controllers</a></li>
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Cameras</a></li>
										<li class="mb-2"><a href="/shop" class="text-white text-decoration-none">Stickers</a></li>
									</ul>
								</div>


								<div class="col col-md-4 col-lg-2 pb24 text-white">
									<p class="mb-4 text-muted small">Contact us</p>
									<p class="mb-4 small">Airproof<br/>10 Rue Van Hove<br/>1000 Brussel</p>
									<ul class="list-unstyled ">
										<li class="mb-2 "><a href="tel:+3222903490" class="small text-white">+32 2 290 34 90</a></li>
										<li><a href="mailto:contact@airproof.com" class="small  text-white">contact@airproof.com</a></li>
									</ul>
								</div>
							</div>
						</div>
					</section>

					<!-- بخش کپی‌رایت و شبکه‌های اجتماعی انتهای فوتر -->
					<div class="o_footer_copyright o_colored_level o_cc bg-black text-white">
						<div class="container pt24 pb24">
							<div class="row align-items-center justify-content-between">
								<div class="col-12 col-md-6">
									<a target="_blank" href="/website/social/facebook" class="me-2 text-white"><i class="fa fa-facebook"/></a>
									<a target="_blank" href="/website/social/youtube" class="me-2 text-white"><i class="fa fa-youtube"/></a>
									<a target="_blank" href="/website/social/instagram" class="me-2 text-white"><i class="fa fa-instagram"/></a>
								</div>
								<div class="col-12 col-md-6 text-end">
									<span class="small text-white">© Airproof. All rights reserved.</span>
								</div>
							</div>
						</div>
					</div>

				</footer>
			</xpath>
		</field>
	</record>

</odoo>
