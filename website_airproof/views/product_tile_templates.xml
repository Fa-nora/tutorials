<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add "Discover more" link on the product card -->
    <template id="products_item" inherit_id="website_sale.products_item" name="Airproof - Products item">
        <xpath expr="//div[hasclass('o_wsale_product_information')]" position="inside">
            <span class="o_airproof_discover_more small text-dark pt-3 pb-1 d-block">Discover more
                <img src="/web/image/website_airproof.img_arrow_small" alt="" class="ms-2"/>
            </span>
        </xpath>
    </template>
</odoo>