<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Deactivate default homepage -->
    <record id="website.homepage" model="ir.ui.view">
       <field name="active" eval="False"/>
    </record>

    <!-- Home -->
    <record id="page_home" model="website.page">
       <field name="name">Home</field>
       <field name="is_published" eval="True"/>
       <field name="is_homepage" eval="True"/>
       <field name="key">website_airproof.page_home</field>
       <field name="url">/</field>
       <field name="type">qweb</field>
       <field name="website_id" eval="1"/>
       <field name="header_overlay" eval="True"/>
       <field name="arch" type="xml">
          <t t-name="website_airproof.page_home">
             <t t-call="website.layout">
                <t t-set="additional_title">One step beyond the horizon | Airproof</t>
                <div id="wrap" class="oe_structure">

                   <!-- Carousel -->
                   <section class="s_airproof_carousel s_carousel_wrapper">
                      <div class="s_carousel s_carousel_default carousel slide" data-bs-interval="10000" id="s_carousel_homepage">
                         <ol class="carousel-indicators o_we_no_overlay">
                            <li data-bs-slide-to="0" class="active" data-bs-target="#s_carousel_homepage"/>
                            <li data-bs-slide-to="1" data-bs-target="#s_carousel_homepage"/>
                         </ol>
                         <div class="carousel-inner">
                            <!-- Slide 01 -->
                            <div class="carousel-item o_colored_level pt24 pb64 active" data-name="Slide">
                               <div class="oe_unremovable container">
                                  <div class="row content">
                                     <div class="carousel-content col-lg-6 pt88 position-relative">
                                        <img src="/web/image/website_airproof.img_sticker"
                                             class="img img-fluid position-absolute x_sticker o_animate o_anim_rotate_in o_visible"
                                             style="animation-delay: 0.8s; --wanim-intensity: 30;"/>
                                        <h1 class="x_carousel_title z-index-1">
                                           <span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom o_visible">
                                              One step<br/>beyond<br/>the horizon
                                           </span>
                                        </h1>
                                        <p class="lead fw-bold">We create custom waterproof drones<br/>for professional pilots.</p>
                                        <a href="/shop" class="mb-2 btn btn-secondary btn-lg">
                                           Discover our drones
                                           <img src="/web/image/website_airproof.img_arrow" alt="" class="img img-fluid ms-2"/>
                                        </a>
                                     </div>
                                     <div class="carousel-content col-lg-6 x_drone_column">
                                        <img src="/web/image/website_airproof.img_drone"
                                             class="img img-fluid x_drone o_animate o_anim_zoom_out o_visible"
                                             alt="Drone"/>
                                        <div class="x_bubble row position-absolute">
                                           <div class="col-5 col-lg-5 offset-lg-7 z-index-1 x_bubble_item x_bubble1 o_cc o_cc1 mb-3 pt24 pb24 px-4">
                                              <p class="fw-bold pb8 m-0">Best drone of the year</p>
                                              <p class="m-0 small">GQ France</p>
                                           </div>
                                           <div class="col-5 col-lg-5 offset-lg-7 z-index-1 x_bubble_item x_bubble2 o_cc o_cc1 mb-3 pt24 pb24 px-4">
                                              <div class="s_rating_icons pb8">
                                                 <span class="s_rating_active_icons">
                                                    <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                                                 </span>
                                                 <span class="s_rating_inactive_icons">
                                                    <i class="fa fa-star-o"/>
                                                 </span>
                                              </div>
                                              <p class="m-0 small"><strong style="font-size: 16px;">1000+</strong> reviews</p>
                                           </div>
                                        </div>
                                     </div>
                                  </div>
                               </div>
                            </div>
                            <!-- Slide 02 -->
                            <div class="carousel-item o_colored_level pt24 pb64" data-name="Slide">
                               <div class="oe_unremovable container">
                                  <div class="row content">
                                     <div class="carousel-content col-lg-6 pt88 position-relative">
                                        <img src="/web/image/website_airproof.img_sticker" class="img img-fluid position-absolute x_sticker"/>
                                        <h1 class="x_carousel_title z-index-1">One step<br/>beyond<br/>the horizon</h1>
                                        <p class="lead fw-bold">We create custom waterproof drones<br/>for professional pilots.</p>
                                        <a href="/shop" class="mb-2 btn btn-secondary btn-lg">
                                           Discover our drones
                                           <img src="/web/image/website_airproof.img_arrow" alt="" class="img img-fluid ms-2"/>
                                        </a>
                                     </div>
                                     <div class="carousel-content col-lg-6 x_drone_column">
                                        <img src="/web/image/website_airproof.img_drone" class="img img-fluid x_drone" alt="Drone"/>
                                        <div class="x_bubble row position-absolute">
                                           <div class="col-5 col-lg-5 offset-lg-7 z-index-1 x_bubble_item x_bubble1 o_cc o_cc1 mb-3 pt24 pb24 px-4">
                                              <p class="fw-bold pb8 m-0">Best drone of the year</p>
                                              <p class="m-0 small">GQ France</p>
                                           </div>
                                           <div class="col-5 col-lg-5 offset-lg-7 z-index-1 x_bubble_item x_bubble2 o_cc o_cc1 mb-3 pt24 pb24 px-4">
                                              <div class="s_rating_icons pb8">
                                                 <span class="s_rating_active_icons">
                                                    <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                                                 </span>
                                                 <span class="s_rating_inactive_icons">
                                                    <i class="fa fa-star-o"/>
                                                 </span>
                                              </div>
                                              <p class="m-0 small"><strong style="font-size: 16px;">1000+</strong> reviews</p>
                                           </div>
                                        </div>
                                     </div>
                                  </div>
                               </div>
                            </div>
                         </div>
                      </div>
                   </section>

                   <!-- Big Boxes -->
                   <div class="o_not_editable">
                      <section class="s_color_blocks_2 pt32 pb32 o_colored_level"
                               data-snippet="s_color_blocks_2"
                               data-name="Big Boxes">
                         <div class="container">
                            <div class="row">
                               <div class="col-lg-12 o_cc o_cc2 o_colored_level oe_img_bg o_bg_img_center p-5 rounded-top text-start border pb152"
                                    style="background-image: url('/web/image/website_airproof.img_drone_robin'); border-width: 10px !important; border-color: rgb(255, 255, 255) !important;">
                                  <div class="o_we_bg_filter bg-black-15"/>
                                  <h2 class="text-o-color-4">Airproof Robin</h2>
                                  <p class="h3 text-o-color-1 pb-4">The dream drone is here</p>
                                  <a href="/shop/airproof-robin-3" class="btn btn-light">Discover more</a>
                               </div>
                               <div class="col-lg-6 o_cc o_cc2 o_colored_level oe_img_bg o_bg_img_center p-5 rounded-bottom text-start border pt152"
                                    style="background-image: url('/web/image/website_airproof.img_accessories'); border-width: 10px !important; border-color: rgb(255, 255, 255) !important; border-radius: 1px 1px 1px 20px !important;">
                                  <div class="o_we_bg_filter bg-black-15"/>
                                  <h2 class="text-o-color-4">Accessories</h2>
                                  <p class="h3 text-o-color-1 pb-4">Customize your drone</p>
                                  <a href="/shop/category/accesories-2" class="text-o-color-4">
                                     Discover more
                                     <img src="/web/image/website_airproof.img_arrow_white" alt="" class="img img-fluid ms-2"/>
                                  </a>
                               </div>
                               <div class="col-lg-6 o_cc o_cc2 o_colored_level oe_img_bg o_bg_img_center p-5 rounded-bottom text-start border pt152"
                                    style="background-image: url('/web/image/website_airproof.img_school'); border-width: 10px !important; border-color: rgb(255, 255, 255) !important; border-radius: 1px 1px 20px !important;">
                                  <div class="o_we_bg_filter bg-black-15"/>
                                  <h2 class="text-o-color-4">Airproof school</h2>
                                  <p class="h3 text-o-color-1 pb-4">Become an expert pilot</p>
                                  <a href="/about-us" class="text-o-color-4">
                                     Discover more
                                     <img src="/web/image/website_airproof.img_arrow_white" alt="" class="img img-fluid ms-2"/>
                                  </a>
                               </div>
                            </div>
                         </div>
                      </section>
                   </div>

                   <!-- Best drone + icons (with animations) -->
                   <section class="s_text_block o_cc o_cc3 o_colored_level pt64 pb0"
                            data-snippet="s_text_block"
                            data-name="Text">
                      <div class="s_allow_columns container">
                         <div class="row o_grid_mode" data-row-count="12">
                            <div class="o_grid_item o_colored_level g-col-lg-8 g-height-3 col-lg-8 text-center"
                                 style="grid-area: 1 / 3 / 4 / 11; z-index: 1;">
                               <h2 class="text-o-color-4">Best drone of the year</h2>
                               <p class="text-o-color-4">
                                  We do this through an unparalleled commitment to
                                  R&amp;D, a culture of constant innovation and curiosity,
                                  and a focus on transforming complex technology into
                                  easy-to-use devices.
                               </p>
                            </div>
                            <div class="o_grid_item o_colored_level g-height-7 g-col-lg-3 col-lg-3 text-center o_anim_fade_in o_animate o_anim_from_bottom o_visible"
                                 style="z-index: 2; grid-area: 6 / 1 / 12 / 4; --wanim-intensity: 15; animation-delay: 0.2s;">
                               <img class="img-fluid m-3 bg-o-color-1 fa-3x rounded-circle p-4 w-25 w-lg-50"
                                    src="/web/image/website_airproof.img_glasses" alt="Glasses icon"/>
                               <h3 class="mt-3 text-white">Immersive Flight</h3>
                               <p class="text-o-color-4">Thanks to our<br/>Next Gen Goggles</p>
                            </div>
                            <div class="o_grid_item o_colored_level g-height-7 g-col-lg-3 col-lg-3 text-center o_anim_fade_in o_animate o_anim_from_bottom o_visible"
                                 style="z-index: 2; grid-area: 5 / 4 / 12 / 7; --wanim-intensity: 15; animation-delay: 0.4s;">
                               <img class="img-fluid m-3 bg-o-color-4 fa-3x rounded-circle p-4 w-25 w-lg-50"
                                    src="/web/image/website_airproof.img_4k" alt="4K image"/>
                               <h3 class="mt-3 text-o-color-4">4K Video</h3>
                               <p class="text-o-color-4">Don’t compromise<br/>on video quality</p>
                            </div>
                            <div class="o_grid_item o_colored_level g-height-7 g-col-lg-3 col-lg-3 text-center o_anim_fade_in o_animate o_anim_from_bottom o_visible"
                                 style="z-index: 2; grid-area: 6 / 7 / 13 / 10; --wanim-intensity: 15; animation-delay: 0.6s;">
                               <img class="img-fluid m-3 bg-o-color-1 fa-3x rounded-circle p-4 w-25 w-lg-50"
                                    src="/web/image/website_airproof.img_hand_drone" alt="drone hold in hand"/>
                               <h3 class="mt-3 text-o-color-4">Palm-Sized</h3>
                               <p class="text-o-color-4">Small but filled<br/>with advanced features</p>
                            </div>
                            <div class="o_grid_item o_colored_level g-height-7 g-col-lg-3 col-lg-3 text-center o_anim_fade_in o_animate o_anim_from_bottom o_visible"
                                 style="z-index: 2; grid-area: 5 / 10 / 12 / 13; --wanim-intensity: 15; animation-delay: 0.8s;">
                               <img class="img-fluid m-3 bg-o-color-4 fa-3x rounded-circle p-4 w-25 w-lg-50"
                                    src="/web/image/website_airproof.img_control" alt="Control icon"/>
                               <h3 class="mt-3 text-o-color-4">Intuitive Control</h3>
                               <p class="text-o-color-4">Squeeze the trigger<br/>and bolt forward</p>
                            </div>
                         </div>
                      </div>
                   </section>

                   <!-- Dynamic products -->
                   <section class="s_dynamic_snippet_products pt0 pb48 s_product_product_airproof o_cc o_cc5"
                            data-snippet="s_dynamic_snippet_products"
                            data-name="Products"
                            data-product-category-id="all"
                            data-show-variants="true"
                            data-number-of-records="16"
                            data-carousel-interval="5000"
                            data-template-key="website_airproof.dynamic_filter_template_product_product_airproof"
                            data-number-of-elements="4"
                            data-number-of-elements-small-devices="2"
                            style="background-image: linear-gradient(0deg, rgb(41, 128, 187) 0%, rgb(11, 142, 230) 100%) !important; --o-wsale-products-grid-gap: 16px;">
                      <div class="container">
                         <div class="row align-items-center mb-5">
                            <div class="col-8 text-start text-o-color-4">
                               <h2 class="m-0 fw-bold">Our latest products</h2>
                            </div>
                         </div>
                         <div class="row">
                            <div class="col-12 o_not_editable">
                               <div class="dynamic_snippet_template"/>
                            </div>
                         </div>
                      </div>
                   </section>

                   <!-- Text-Image + Background waves + Image shape duo -->
                   <section class="s_text_image o_cc o_cc3 o_colored_level pt120 pb96"
                            data-snippet="s_image_text"
                            data-name="Image - Text"
                            style="background-color: rgb(41, 128, 187);"
                            data-oe-shape-data="{'shape': 'website_airproof/waves/01', 'colors': {'c1': '#BBE1FA'}, 'flip': ['x']}">
                      <div class="o_we_shape o_website_airproof_waves_01 o_we_flip_x"
                           style="background-image: url('/html_editor/shape/website_airproof%2Fwaves%2F01.svg?c1=%23BBE1FA'); background-position: 100% 100%;"/>
                      <div class="container">
                         <div class="row align-items-center">
                            <div class="col-lg-4 offset-lg-1 pt16 pb16 o_colored_level">
                               <img src="/html_editor/image_shape/website_airproof.img_drone_flying/website_airproof/duo/01.svg"
                                    class="img img-fluid mx-auto"
                                    alt="Drone flying"
                                    data-shape="website_airproof/duo/01"
                                    data-shape-colors=";#CEF8A1;;;"
                                    data-mimetype="image/svg+xml"
                                    data-mimetype-before-conversion="image/webp"
                                    data-original-src="website_airproof/static/src/img/content/drone-flying.webp"
                                    data-file-name="drone-flying.svg"
                                    loading="lazy"/>
                            </div>
                            <div class="col-lg-5 offset-lg-1 pt16 pb16 o_colored_level">
                               <span class="text-o-color-1 text-uppercase">The sky is the limit</span>
                               <h2 class="pb-4">The TikTok Creator's <br/>Dream Drone</h2>
                               <p class="pb-3 lead fw-bold">This drone offers true vertical video shooting for all your TikTok and Instagram Reels needs.</p>
                               <a href="#" class="mb-2 btn btn-primary btn-lg">Read more
                                  <img src="/web/image/website_airproof.img_arrow_white" alt="" class="img img-fluid ms-2"/>
                               </a>
                            </div>
                         </div>
                      </div>
                   </section>

                </div>
             </t>
          </t>
       </field>
    </record>

</odoo>