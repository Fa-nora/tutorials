<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

	<!-- ۱. غیرفعال کردن صفحه خانگی پیش‌فرض وب‌سایت اودو -->
	<record id="website.homepage" model="ir.ui.view">
		<field name="active" eval="False"/>
	</record>

	<!-- ۲. ثبت و رندر لایه اصلی صفحه خانگی سفارشی ایرپروف -->
	<record id="page_home" model="website.page">
		<field name="name">Home</field>
		<field name="is_published" eval="True"/>
		<field name="is_homepage" eval="True"/>
		<field name="key">airproof_website.page_home</field>
		<field name="url">/</field>
		<field name="type">qweb</field>
		<field name="header_overlay" eval="True"/>
		<field name="website_id" eval="1"/>
		<field name="arch" type="xml">
			<t t-name="airproof_website.page_home">
				<t t-call="website.layout">
					<t t-set="additional_title">One step beyond the horizon | Airproof</t>

					<div id="wrap" class="oe_structure">

						<!-- بخش اول: بنر چرخشی بزرگ بالای صفحه (Carousel) به همراه انیمیشن ورودی روان متن‌ها -->
						<section class="s_airproof_carousel s_carousel_wrapper">
							<div class="s_carousel s_carousel_default carousel slide" data-bs-interval="10000" id="s_carousel_homepage">
								<ol class="carousel-indicators o_we_no_overlay">
									<li data-bs-slide-to="0" class="active" data-bs-target="#s_carousel_homepage"/>
									<li data-bs-slide-to="1" data-bs-target="#s_carousel_homepage"/>
								</ol>
								<div class="carousel-inner">
									<!-- اسلاید شماره ۱ -->
									<div class="carousel-item o_colored_level pt24 pb64 active" data-name="Slide">
										<div class="oe_unremovable container">
											<div class="row content">
												<div class="carousel-content col-lg-6 pt88 position-relative">
													<img src="/web/image/airproof_website.img_sticker"
													     class="img img-fluid position-absolute x_sticker o_animate o_anim_rotate_in o_visible"
													     style="animation-delay: 0.8s; --wanim-intensity: 30;"/>
													<h1 class="x_carousel_title z-index-1">
														<span class="o_animated_text o_animate o_anim_fade_in o_anim_from_bottom o_visible">
														    One step<br/>beyond<br/>the horizon
														</span>
													</h1>
													<p class="lead fw-bold">We create custom waterproof drones<br/>for professional pilots.</p>
													<a href="/shop" class="mb-2 btn btn-secondary btn-lg">
														Discover our drones
														<img src="/web/image/airproof_website.img_arrow" alt="" class="img img-fluid ms-2"/>
													</a>
												</div>
												<div class="carousel-content col-lg-6 x_drone_column">
													<img src="/web/image/airproof_website.img_drone" class="img img-fluid x_drone o_animate o_anim_zoom_out o_visible" alt="Drone"/>
													<div class="x_bubble row position-absolute">
														<div class="col-5 col-lg-5 offset-lg-7 z-index-1 x_bubble_item x_bubble1 o_cc o_cc1 mb-3 pt24 pb24 px-4">
															<p class="fw-bold pb8 m-0">Best drone of the year</p>
															<p class="m-0 small">GQ France</p>
														</div>
														<div class="col-5 col-lg-5 offset-lg-7 z-index-1 x_bubble_item x_bubble2 o_cc o_cc1 mb-3 pt24 pb24 px-4">
															<div class="s_rating_icons pb8">
																<span class="s_rating_active_icons">
																	<i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
																</span>
																<span class="s_rating_inactive_icons">
																	<i class="fa fa-star-o"/>
																</span>
															</div>
															<p class="m-0 small"><strong style="font-size: 16px;">1000+</strong> reviews</p>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
									<!-- اسلاید شماره ۲ -->
									<div class="carousel-item o_colored_level pt24 pb64" data-name="Slide">
										<div class="oe_unremovable container">
											<div class="row content">
												<div class="carousel-content col-lg-6 pt88 position-relative">
													<img src="/web/image/airproof_website.img_sticker" class="img img-fluid position-absolute x_sticker"/>
													<h1 class="x_carousel_title z-index-1">One step<br/>beyond<br/>the horizon</h1>
													<p class="lead fw-bold">We create custom waterproof drones<br/>for professional pilots.</p>
													<a href="/shop" class="mb-2 btn btn-secondary btn-lg">
														Discover our drones
														<img src="/web/image/airproof_website.img_arrow" alt="" class="img img-fluid ms-2"/>
													</a>
												</div>
												<div class="carousel-content col-lg-6 x_drone_column">
													<img src="/web/image/airproof_website.img_drone" class="img img-fluid x_drone" alt="Drone"/>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</section>

						<!-- بخش دوم: ۳ باکس اطلاعاتی بزرگ بالای سایت با اصلاح دقیق آدرس فیزیکی تصاویر به airproof_website -->
						<div class="o_not_editable">
							<section class="s_color_blocks_2 pt32 pb32 o_colored_level" data-snippet="s_color_blocks_2" data-name="Big Boxes">
								<div class="container">
									<div class="row">
										<!-- باکس بزرگ: Airproof Robin -->
										<div class="col-lg-12 o_cc o_cc2 o_colored_level oe_img_bg o_bg_img_center p-5 text-start border pb152"
										     style="background-image: url('/web/image/airproof_website.img_drone_robin'); border-width: 10px !important; border-color: rgb(255, 255, 255) !important; border-radius: 20px 20px 0 0 !important;">
											<div class="o_we_bg_filter bg-black-15"/>
											<h2 class="text-o-color-4 pb-4">Airproof Robin</h2>
											<p class="h3 text-o-color-1 pb-4">The dream drone is here</p>
											<a href="/shop" class="btn btn-light">Discover more</a>
										</div>
										<!-- باکس کوچک چپ: Accessories -->
										<div class="col-lg-6 o_cc o_cc2 o_colored_level oe_img_bg o_bg_img_center p-5 rounded-bottom text-start border rounded pt152"
										     style="background-image: url('/web/image/airproof_website.img_accessories'); border-width: 10px !important; border-color: rgb(255, 255, 255) !important; border-radius: 1px 1px 1px 20px !important;">
											<div class="o_we_bg_filter bg-black-15"/>
											<h2 class="text-o-color-4 pb-4">Accessories</h2>
											<p class="h3 text-o-color-1 pb-4">Customize your drone</p>
											<a href="/shop" class="text-o-color-4">
												Discover more
												<img src="/web/image/airproof_website.img_arrow_white" alt="" class="img img-fluid ms-2"/>
											</a>
										</div>
										<!-- باکس کوچک راست: Airproof school -->
										<div class="col-lg-6 o_cc o_cc2 o_colored_level oe_img_bg o_bg_img_center p-5 rounded-bottom text-start border rounded pt152"
										     style="background-image: url('/web/image/airproof_website.img_school'); border-width: 10px !important; border-color: rgb(255, 255, 255) !important; border-radius: 1px 1px 20px !important;">
											<div class="o_we_bg_filter bg-black-15"/>
											<h2 class="text-o-color-4 pb-4">Airproof school</h2>
											<p class="h3 text-o-color-1 pb-4">Become an expert pilot</p>
											<a href="/about-us" class="text-o-color-4">
												Discover more
												<img src="/web/image/airproof_website.img_arrow_white" alt="" class="img img-fluid ms-2"/>
											</a>
										</div>
									</div>
								</div>
							</section>
						</div>

						<!-- بخش سوم-->
						<section class="s_text_block o_cc o_cc3 o_colored_level pt64 pb64" data-snippet="s_text_block" data-name="Text">
							<div class="s_allow_columns container">

								<!-- تیتر و توضیحات تراز وسط -->
								<div class="row justify-content-center mb-5">
									<div class="col-lg-8 text-center">
										<h2 class="display-4 fw-bold text-white mb-3">Best drone of the year</h2>
										<p class="text-white-75 lh-lg mx-auto" style="max-width: 650px;">
											We do this through an unparalleled commitment to R&amp;D, a culture of constant innovation and curiosity, and a focus on transforming complex technology into easy-to-use devices.
										</p>
									</div>
								</div>

								<!-- گرید سیستم ۴ ستونه آیکون‌ها منطبق بر تصویر هدف گیت‌هاب -->
								<div class="row o_grid_mode text-center justify-content-center" data-row-count="12">
									<!-- آیکون ۱ -->
									<div class="o_grid_item o_colored_level g-height-7 g-col-lg-3 col-lg-3 text-center o_anim_fade_in o_animate o_anim_from_bottom o_visible"
									     style="z-index: 2; grid-area: 5 / 1 / 12 / 4; --wanim-intensity: 15; animation-delay: 0.2s;">
										<img class="img-fluid m-3 bg-o-color-1 fa-3x rounded-circle p-4 w-25 w-lg-50 shadow-sm"
										     src="/airproof_website/static/src/img/content/icons/glasses.svg" alt="Glasses icon" style="max-width: 100px;"/>
										<h3 class="mt-3 text-white fw-bold h4">Immersive Flight</h3>
										<p class="text-white-50 small mt-2">Thanks to our<br/>Next Gen Goggles</p>
									</div>
									<!-- آیکون ۲ -->
									<div class="o_grid_item o_colored_level g-height-7 g-col-lg-3 col-lg-3 text-center o_anim_fade_in o_animate o_anim_from_bottom o_visible"
									     style="z-index: 2; grid-area: 5 / 4 / 12 / 7; --wanim-intensity: 15; animation-delay: 0.4s;">
										<img class="img-fluid m-3 bg-o-color-4 fa-3x rounded-circle p-4 w-25 w-lg-50 shadow-sm"
										     src="/airproof_website/static/src/img/content/icons/4k.svg" alt="4K image" style="max-width: 100px;"/>
										<h3 class="mt-3 text-white fw-bold h4">4K Video</h3>
										<p class="text-white-50 small mt-2">Don’t compromise<br/>on video quality</p>
									</div>
									<!-- آیکون ۳ -->
									<!-- آیکون ۳: پهباد در دست (Palm-Sized) -->
									<div class="o_grid_item o_colored_level g-height-7 g-col-lg-3 col-lg-3 text-center o_anim_fade_in o_animate o_anim_from_bottom o_visible"
									     style="z-index: 2; grid-area: 5 / 7 / 12 / 10; --wanim-intensity: 15; animation-delay: 0.6s;">
										<img class="img-fluid m-3 bg-o-color-1 fa-3x rounded-circle p-4 w-25 w-lg-50 shadow-sm"
										     src="/airproof_website/static/src/img/content/icons/hand-drone.svg" alt="drone hold in hand" style="max-width: 100px;"/>
										<h3 class="mt-3 text-white fw-bold h4">Palm-Sized</h3>
										<p class="text-white-50 small mt-2">Small but filled<br/>with advanced features</p>
									</div>

									<!-- آیکون ۴: کنترلر (Intuitive Control) -->
									<div class="o_grid_item o_colored_level g-height-7 g-col-lg-3 col-lg-3 text-center o_anim_fade_in o_animate o_anim_from_bottom o_visible"
									     style="z-index: 2; grid-area: 5 / 10 / 12 / 13; --wanim-intensity: 15; animation-delay: 0.8s;">
										<img class="img-fluid m-3 bg-o-color-4 fa-3x rounded-circle p-4 w-25 w-lg-50 shadow-sm"
										     src="/airproof_website/static/src/img/content/icons/control.svg" alt="Control icon" style="max-width: 100px;"/>
										<h3 class="mt-3 text-white fw-bold h4">Intuitive Control</h3>
										<p class="text-white-50 small mt-2">Squeeze the trigger<br/>and bolt forward</p>
									</div>

								</div>
							</div>

							<!-- اسلایدر جدیدترین محصولات دقیقاً تراز با باکس‌های سفید رنگ پایین عکس گیت‌هاب شما -->
							<div data-snippet="s_dynamic_snippet_products"
							     class="s_dynamic_snippet_products s_dynamic s_dynamic_empty pt48 pb32 s_product_product_airproof o_dynamic_snippet_empty o_cc o_cc5"
							     data-custom-template-data="{}" data-name="Products" data-product-category-id="all" data-show-variants="true" data-number-of-records="16" data-filter-id="3" data-carousel-interval="5000"
							     data-template-key="airproof_website.dynamic_filter_template_product_product_airproof" data-number-of-elements="4" data-number-of-elements-small-devices="2"
							     style="background-image: linear-gradient(0deg, rgb(41, 128, 187) 0%, rgb(11, 142, 230) 100%) !important; --o-wsale-products-grid-gap: 24px;">
								<div class="container">
									<div class="row s_nb_column_fixed">
										<div class="s_dynamic_snippet_title oe_unremovable oe_unmovable d-flex flex-column flex-md-row mb-4 pb-2 o_colored_level justify-content-between">
											<div class="text-o-color-4">
												<h2 class="fw-bold text-white">Our latest products</h2>
											</div>
										</div>
										<div class="s_dynamic_snippet_content oe_unremovable oe_unmovable o_not_editable col o_colored_level">
											<div class="css_non_editable_mode_hidden">
												<div class="missing_option_warning alert alert-info fade show d-none d-print-none rounded-0 o_default_snippet_text">
													Your Dynamic Snippet will be displayed here...
												</div>
											</div>
											<div class="dynamic_snippet_template"/>
										</div>
									</div>
								</div>
							</div>
						</section>

						<!-- بخش چهارم: معرفی پهباد تیک‌تاک و لود کامل وکتور پس‌زمینه شکل موج‌ها -->
						<section class="s_text_image o_cc o_cc3 o_colored_level pt120 pb96 position-relative"
						         data-snippet="s_image_text" data-name="Image - Text" style="background-color: rgb(41, 128, 187);">
							<div class="container position-relative" style="z-index: 2;">
								<div class="row align-items-center">
									<div class="col-lg-6 pt16 pb16 o_colored_level text-start">
										<h2 class="pb-4 display-5 fw-bold text-white">The TikTok Creator's Dream Drone</h2>
										<p class="pb-3 lead text-white-75 fw-medium">This drone offers true vertical video shooting for all your TikTok and Instagram Reels needs.</p>
										<a href="/shop" class="mb-2 btn btn-primary btn-lg px-4 rounded">Read more</a>
									</div>
								</div>
							</div>
						</section>

					</div>
				</t>
			</t>
		</field>
	</record>
</odoo>
