<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Delete default menus -->
    <delete model="website.menu" search="[('url','in', ['/', '/']), ('website_id', '=', 1)]"/>
    <delete model="website.menu" search="[('url','in', ['/', '/blog']), ('website_id', '=', 1)]"/>
    <delete model="website.menu" search="[('url','in', ['/', '/shop']), ('website_id', '=', 1)]"/>
    <delete model="website.menu" search="[('url','in', ['/', '/contactus']), ('website_id', '=', 1)]"/>

    <!-- Waterproof drones -->
    <record id="menu_drones" model="website.menu">
        <field name="is_mega_menu" eval="True"/>
        <field name="name">Waterproof drones</field>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', 1)]"/>
        <field name="website_id">1</field>
        <field name="sequence" type="int">10</field>
        <field name="mega_menu_content" type="html">
            <section class="s_mega_menu_cards pt24 pb24" style="background-color: #F4F4F4 !important;">
                <div class="container">
                    <div class="row">
                        <div class="col-6 col-sm text-center pt8 pb8 o_colored_level">
                            <a href="/shop/airproof-mini-1" class="nav-link p-0">
                                <img src="/web/image/website_airproof.img_mini" class="img-fluid img" alt="Airproof Mini"/>
                                <div class="p-2"><font class="fw-bold">Airproof Mini</font></div>
                            </a>
                        </div>
                        <div class="col-6 col-sm text-center pt8 pb8 o_colored_level">
                            <a href="/shop/airproof-pro-2" class="nav-link p-0">
                                <img src="/web/image/website_airproof.img_pro" class="img-fluid img" alt="Airproof Pro"/>
                                <div class="p-2"><font class="fw-bold">Airproof Pro</font></div>
                            </a>
                        </div>
                        <div class="col-6 col-sm text-center pt8 pb8 o_colored_level">
                            <a href="/shop/airproof-robin-3" class="nav-link p-0">
                                <img src="/web/image/website_airproof.img_robin" class="img-fluid img" alt="Airproof Robin"/>
                                <div class="p-2"><font class="fw-bold">Airproof Robin</font></div>
                            </a>
                        </div>
                        <div class="col-6 col-sm text-center pt8 pb8 o_colored_level">
                            <a href="/shop/airproof-falcon-4" class="nav-link p-0">
                                <img src="/web/image/website_airproof.img_falcon" class="img-fluid img" alt="Airproof Falcon"/>
                                <div class="p-2"><font class="fw-bold">Airproof Falcon</font></div>
                            </a>
                        </div>
                        <div class="col-6 col-sm text-center pt8 pb8 o_colored_level">
                            <a href="/shop/airproof-eagle-5" class="nav-link p-0">
                                <img src="/web/image/website_airproof.img_eagle" class="img-fluid img" alt="Airproof Eagle"/>
                                <div class="p-2"><font class="fw-bold">Airproof Eagle</font></div>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </field>
    </record>

    <!-- About us -->
    <record id="menu_about" model="website.menu">
        <field name="name">About us</field>
        <field name="url">/about-us</field>
        <field name="website_id">1</field>
        <field name="parent_id" eval="ref('website.default_website').menu_id.id"/>
        <field name="sequence" type="int">20</field>


    </record>

    <!-- Blog,Dropdown -->
    <record id="menu_blog" model="website.menu">
        <field name="name">Blog</field>
	    <field name="url">/</field>
        <field name="parent_id" eval="ref('website.default_website').menu_id.id"/>
        <field name="website_id">1</field>
        <field name="sequence" type="int">30</field>
    </record>
    <record id="menu_blog_item_1" model="website.menu">
        <field name="name">Our latest news</field>
        <field name="url">/blog/our-latest-news-2</field>
        <field name="website_id">1</field>
        <field name="parent_id" eval="ref('website.default_website').menu_id.id"/>
        <field name="sequence" type="int">31</field>
    </record>
    <record id="menu_blog_item_2" model="website.menu">
        <field name="name">Tutorials</field>
        <field name="url">/blog/tutorials-3</field>
        <field name="website_id">1</field>
        <field name="parent_id" eval="ref('website.default_website').menu_id.id"/>
        <field name="sequence" type="int">32</field>
    </record>

    <!-- Contact us -->
    <record id="menu_contact" model="website.menu">
        <field name="name">Contact us</field>
        <field name="url">/contactus</field>
        <field name="website_id">1</field>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', 1)]"/>
        <field name="sequence" type="int">40</field>
    </record>
</odoo>