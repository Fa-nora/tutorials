"                                                </t>\n"
"                                                <t t-if=\"inv.invoice_date_due\">\n"
"                                                    <span style=\"font-weight:bold;\">Échéance :</span> <t t-out=\"inv.invoice_date_due\"/>\n"
"                                                </t>\n"
"                                            </p>\n"
"                                        </t>\n"
"\n"
