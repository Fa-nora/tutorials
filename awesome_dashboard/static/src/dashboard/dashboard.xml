<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">

        <Layout
            display="{ controlPanel: {} }"
            className="'o_dashboard h-100'"
        >

            <t t-set-slot="control-panel-create-button">

                <!-- دکمه Customers -->
                <button
                    class="btn btn-primary"
                    t-on-click="openCustomers"
                >
                    Customers
                </button>

                <!-- دکمه Leads -->
                <button
                    class="btn btn-secondary ms-2"
                    t-on-click="openLeads"
                >
                    Leads
                </button>

                <!-- دکمه Settings -->
                <button
                    class="btn btn-secondary ms-2"
                    t-on-click="openSettings"
                    title="Settings"
                >
                    ⚙️
                </button>

            </t>

            <!-- نمایش کارت‌ها -->
            <div class="p-3 d-flex flex-wrap">

                <t
                    t-foreach="displayedItems"
                    t-as="item"
                    t-key="item.id"
                >

                    <DashboardItem
                        size="item.size || 1"
                    >

                        <!--  اینجا باید getItemProps استفاده شود
                             تا dashboard به item.props ارسال شود.-->
                        <t
                            t-set="itemProps"
                            t-value="getItemProps(item)"
                        />

                        <t
                            t-component="item.Component"
                            t-props="itemProps"
                        />

                    </DashboardItem>

                </t>

            </div>

        </Layout>

    </t>

</templates>